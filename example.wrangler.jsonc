{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "celeste-skill-rating",
	"compatibility_date": "2026-10-03",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "1660e283847147bbbed0c02eab1a767d",
			"localConnectionString": "postgres://user:password@ip:5432/dbname?sslmode=require"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false
		}
	},
	"vars": {
		"DISCORD_REDIRECT_URI": "http://localhost:5173/login/discord/callback"
	}
}
