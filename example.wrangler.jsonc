{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "celeste-skill-rating",
	"compatibility_date": "2026-10-03",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "1660e283847147bbbed0c02eab1a767d",
			"localConnectionString": "postgres://user:password@ip:5432/dbname?sslmode=require"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "player-images"
		}
	],
	"vars": {
		"DISCORD_REDIRECT_URI": "http://localhost:5173/login/discord/callback",
		"DISCORD_SERVER_ID": "927897210471989270",
		"DISCORD_SHOUTOUT_CHANNEL_ID": "1277745299795738656"
	},
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"issues": {
			"enabled": true
		},
		"logs": {
			"enabled": true
		},
		"traces": {
			"enabled": true
		}
	}
}
