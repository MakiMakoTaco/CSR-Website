{
	"name": "csr-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "npm run build && npx wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"check": "wrangler types --check"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^4.7.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.51.0",
		"vite": "^7.3.1",
		"wrangler": "^4.148.0"
	},
	"dependencies": {
		"@discordjs/rest": "^2.6.3",
		"arctic": "^3.7.0",
		"discord-api-types": "^0.38.56",
		"dotenv": "^17.3.1",
		"postgres": "^3.4.8"
	},
	"allowScripts": {
		"workerd@1.20261006.1": true,
		"esbuild@0.24.2": true
	}
}
